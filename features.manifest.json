{
  "$comment": "开放仓库相对上游新增的功能清单。唯一事实来源：增删功能时同步本文件，并运行 npm run check:features。字段含义与增删流程见 docs/FEATURES.md。",
  "features": [
    {
      "id": "reader",
      "title": "沉浸式 Markdown 阅读",
      "dir": "src/features/reader",
      "entry": "src/features/reader/index.ts",
      "publicApi": [
        "createReaderFeature",
        "READER_ENTRY_SELECTOR"
      ],
      "hostPort": "ReaderHost",
      "facade": "ReaderFeature",
      "eager": false,
      "reason": "阅读层连同 HTML 解析栈与样式表按需加载，三维入口首屏不为它付费（IR 计划 §5.3.2、§11.3）。",
      "styles": [
        "reader.css",
        "markdown.css"
      ],
      "styleEntry": "src/features/reader/styles.ts",
      "checks": [
        "test:reader",
        "test:reader-e2e",
        "check:reader",
        "check:reader-content",
        "build:reader-fixtures"
      ],
      "reviewContract": [
        "active",
        "state",
        "load",
        "pendingLink",
        "pendingToken",
        "lastDecline",
        "moduleLoaded"
      ],
      "runtimeMarkers": [
        "article-reader",
        "reader-sheet"
      ],
      "serverSide": [],
      "ops": [],
      "scripts": [
        "scripts/reading"
      ],
      "shared": [
        "shared/reading"
      ],
      "surfaces": [],
      "docs": [
        "docs/READER.md"
      ]
    },
    {
      "id": "album-viewer",
      "title": "影像档案（图集）查看器",
      "dir": "src/features/album-viewer",
      "entry": "src/features/album-viewer/index.ts",
      "publicApi": [
        "createAlbumViewerFeature",
        "ALBUM_VIEWER_ENTRY_SELECTOR"
      ],
      "hostPort": "AlbumViewerHost",
      "facade": "AlbumViewerFeature",
      "eager": false,
      "reason": "查看器浮层与样式表按需加载：图集是少数派入口，三维入口首屏不为它付费。",
      "styles": [
        "viewer.css"
      ],
      "styleEntry": "src/features/album-viewer/styles.ts",
      "checks": [],
      "reviewContract": [
        "active",
        "album",
        "index",
        "moduleLoaded"
      ],
      "runtimeMarkers": [
        "album-viewer"
      ],
      "serverSide": [],
      "ops": [],
      "scripts": [],
      "shared": [],
      "surfaces": [],
      "docs": [
        "docs/ALBUM.md"
      ]
    },
    {
      "id": "music-player",
      "title": "音乐播放器（曲目 · 歌词 · 播放参数）",
      "dir": "src/features/music-player",
      "entry": "src/features/music-player/index.ts",
      "publicApi": [
        "createMusicPlayerFeature",
        "MUSIC_ENTRY_SELECTOR"
      ],
      "hostPort": "MusicPlayerHost",
      "facade": "MusicPlayerFeature",
      "eager": false,
      "reason": "播放器浮层、歌词解析与样式表按需加载：曲目是少数派入口，三维入口首屏不为它付费。",
      "styles": [
        "player.css"
      ],
      "styleEntry": "src/features/music-player/styles.ts",
      "checks": [],
      "reviewContract": [
        "active",
        "track",
        "playing",
        "moduleLoaded"
      ],
      "runtimeMarkers": [
        "music-player"
      ],
      "serverSide": [],
      "ops": [],
      "scripts": [],
      "shared": [],
      "surfaces": [],
      "docs": [
        "docs/MUSIC.md"
      ]
    }
  ]
}
