{
  "$comment": "开放仓库相对上游新增的功能清单。唯一事实来源：增删功能时同步本文件，并运行 npm run check:features。字段含义与增删流程见 docs/FEATURES.md。",
  "features": [
    {
      "id": "reader",
      "title": "沉浸式 Markdown 阅读",
      "dir": "src/features/reader",
      "entry": "src/features/reader/index.ts",
      "publicApi": [
        "createReaderFeature",
        "READER_ENTRY_SELECTOR"
      ],
      "hostPort": "ReaderHost",
      "facade": "ReaderFeature",
      "eager": false,
      "reason": "阅读层连同 HTML 解析栈与样式表按需加载，三维入口首屏不为它付费（IR 计划 §5.3.2、§11.3）。",
      "styles": [
        "reader.css",
        "markdown.css"
      ],
      "styleEntry": "src/features/reader/styles.ts",
      "checks": [
        "test:reader",
        "test:reader-e2e",
        "check:reader",
        "check:reader-content",
        "build:reader-fixtures"
      ],
      "reviewContract": [
        "active",
        "state",
        "load",
        "pendingLink",
        "pendingToken",
        "lastDecline",
        "moduleLoaded"
      ],
      "runtimeMarkers": [
        "article-reader",
        "reader-sheet"
      ],
      "serverSide": [],
      "ops": [],
      "scripts": [
        "scripts/reading"
      ],
      "shared": [
        "shared/reading"
      ],
      "surfaces": [],
      "docs": [
        "docs/READER.md"
      ]
    }
  ]
}
